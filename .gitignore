# MkDocs build output
_site/

# Python virtual environment
.venv/
.venv-manim/

# Manim render output
media/

# Python cache
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Keep instructor notes out of every published session-material folder
**/session_material/*[Nn]otes*.pdf
**/session_material/*[Nn]otes*.tex
**/session_material/*[Aa]nnote*.pdf
**/session_material/*[Aa]nnote*.tex
**/session_material/*[Nn]otes*_figures/

# Store all future instructor lecture notes and copyable figures here, by session.
# The entire folder stays local and must never be committed or pushed.
/instructor_material/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
